      "properties": {},
      "widgets_values": [
        "Title:   Fruits and vegetables at market\nCreator: Santeri Viinamaki\nLicense: CC BY-SA 4.0 (attribution + share-alike)\n         https://creativecommons.org/licenses/by-sa/4.0/\nSource:  https://commons.wikimedia.org/wiki/File:Fruits_and_vegetables_at_market.jpg\nSize:    market_scene.jpg 1000x750 (downscaled from 4592x3448). The template is the unique round red sale tag cropped from the scene\nFull provenance: example_inputs/sources.txt"
      ],
      "color": "#332922",
